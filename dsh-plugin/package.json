{
  "name": "dsh-prompt-enhance-cn",
  "description": "Four-tier prompt enhancement for the dsh web GUI: base / standard / professional / system. Rewrites the composer draft through the harness LLM service, previews or fills back in place, and always keeps the original draft recoverable.",
  "version": "0.3.3",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client/index.tsx",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.2 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots",
        "react-dom"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "esbuild": "~0.25.0",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.2.0",
    "typescript": "~5.7.2",
    "vitest": "^3.0.0"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "src",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "README.zh-CN.md"
  ],
  "license": "Apache-2.0",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "prompt",
    "prompt-enhancement"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qwe3120695033/prompt-enhancer.git",
    "directory": "dsh-plugin"
  },
  "bugs": {
    "url": "https://github.com/qwe3120695033/prompt-enhancer/issues"
  },
  "homepage": "https://github.com/qwe3120695033/prompt-enhancer/tree/main/dsh-plugin#readme",
  "scripts": {
    "gen:tiers": "node scripts/generate-tiers.mjs",
    "build": "node scripts/generate-tiers.mjs --check && tsc -p . && node scripts/build.mjs",
    "install:profile": "node scripts/install-profile.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p . --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run gen:tiers && npm run build && npm test",
    "verify:profile": "node scripts/verify-profile.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
